# Copy this file to .env.navasan, then fill in your API key.
# .env.navasan is gitignored — never commit the key.
NAVASAN_API_KEY=replace-with-your-navasan-api-key

# Optional overrides (see cmd/navasan-translator/README.md for the full list):
# PORT=8088
# NAVASAN_API_URL=http://api.navasan.tech/latest/
# NAVASAN_PIVOT_SYMBOL=usd_sell
# NAVASAN_PIVOT_CURRENCY=USD
# NAVASAN_CACHE_TTL=5m
# NAVASAN_HTTP_TIMEOUT=30s
#
# run-native.sh already points the backend at the translator; only set this to
# override the feed URL for the backend (e.g. to test another endpoint):
# EXCHANGE_RATES_URL=http://127.0.0.1:8088/latest.json
