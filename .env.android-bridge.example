# Copy this file to .env.android-bridge, then fill in both tokens.
BRIDGE_LISTEN=:8788
GOMONEY_URL=http://127.0.0.1:52055
GOMONEY_SERVICE_TOKEN=replace-with-gomoney-service-token
BRIDGE_TOKEN=replace-with-random-bridge-token
BRIDGE_DEDUP_DB="${HOME}/.gomoney-android-bridge/dedup.db"
BRIDGE_MAPPINGS="${HOME}/.gomoney-android-bridge/mappings.json"
