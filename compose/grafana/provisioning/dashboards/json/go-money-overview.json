        {
          "datasource": { "type": "postgres", "uid": "go-money-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT DATE_TRUNC('month', transaction_date_only)::timestamp AS time, SUM(CASE WHEN transaction_type = 2 THEN destination_amount_in_base_currency ELSE 0 END) AS income, SUM(CASE WHEN transaction_type = 3 THEN destination_amount_in_base_currency ELSE 0 END) AS expenses FROM transactions WHERE deleted_at IS NULL AND transaction_type IN (2, 3) AND $__timeFilter(transaction_date_only) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Monthly income vs expenses",
      "type": "timeseries"
    },
    {
