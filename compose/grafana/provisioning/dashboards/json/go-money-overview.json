          "datasource": { "type": "postgres", "uid": "go-money-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(c.name, 'Uncategorized') AS category, SUM(t.destination_amount_in_base_currency) AS total FROM transactions t LEFT JOIN categories c ON c.id = t.category_id WHERE t.transaction_type = 3 AND t.deleted_at IS NULL AND $__timeFilter(t.transaction_date_only) GROUP BY 1 ORDER BY total DESC",
          "refId": "A"
        }
      ],
      "title": "Spending by category",
      "type": "piechart"
