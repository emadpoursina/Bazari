        {
          "datasource": { "type": "postgres", "uid": "go-money-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT tg.name AS tag, SUM(t.destination_amount_in_base_currency) AS total FROM transactions t JOIN tags tg ON tg.id = ANY(t.tag_ids) WHERE t.transaction_type = 3 AND t.deleted_at IS NULL AND $__timeFilter(t.transaction_date_only) GROUP BY tg.name ORDER BY total DESC",
