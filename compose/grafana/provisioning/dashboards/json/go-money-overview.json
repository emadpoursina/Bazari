        {
          "datasource": { "type": "postgres", "uid": "go-money-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(CASE WHEN a.type = 1 THEN a.current_balance / NULLIF(c.rate, 0) WHEN a.type = 4 THEN -a.current_balance / NULLIF(c.rate, 0) ELSE 0 END) AS \"Net worth\" FROM accounts a JOIN currencies c ON c.id = a.currency WHERE a.type IN (1, 4) AND a.deleted_at IS NULL",
          "refId": "A"
        }
      ],
      "title": "Net worth (base)",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "go-money-postgres" },
