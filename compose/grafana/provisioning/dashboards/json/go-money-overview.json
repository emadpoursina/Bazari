          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(destination_amount_in_base_currency), 0) AS \"Income\" FROM transactions WHERE transaction_type = 2 AND deleted_at IS NULL AND DATE_TRUNC('month', transaction_date_only) = DATE_TRUNC('month', CURRENT_DATE)",
