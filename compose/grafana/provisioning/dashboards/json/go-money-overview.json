      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "go-money-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name, CASE a.type WHEN 1 THEN 'Asset' WHEN 4 THEN 'Liability' WHEN 5 THEN 'Expense' WHEN 6 THEN 'Income' WHEN 7 THEN 'Adjustment' ELSE a.type::text END AS type, a.currency, a.current_balance AS balance FROM accounts a WHERE a.deleted_at IS NULL AND a.type IN (1, 4) ORDER BY a.current_balance DESC",
